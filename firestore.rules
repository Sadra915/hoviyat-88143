rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == "YTxAE8HNmPYfVfNBJCUPlG9ai3Y2"; }
    function isMember(data) { return signedIn() && request.auth.uid in data.members; }
    function isGroupAdmin(data) { return signedIn() && request.auth.uid in data.admins; }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- کاربران ----------
    match /users/{uid} {
      // خواندن/لیست کردن پروفایل‌ها برای هر کاربر واردشده لازم است (پیدا کردن مخاطب، انتخاب عضو گروه و...)
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // خود کاربر هر فیلدی از پروفایلش را می‌تواند تغییر دهد بجز «verified»؛
      // فقط ادمین می‌تواند حساب کسی را تایید/لغو تایید کند.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.verified == resource.data.verified);
      allow delete: if isAdmin();
    }

    // ---------- رزرو یوزرنیم یکتا (فقط هنگام ثبت‌نام نوشته می‌شود، هرگز تغییر/حذف نمی‌شود) ----------
    match /usernames/{uname} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- یادداشت سریع Smart Space (فقط خود کاربر) ----------
    match /notes/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- چت خصوصی ----------
    match /chats/{chatId} {
      allow read, update: if isMember(resource.data);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && onlyChanged(["reactions"]);
        allow delete: if isAdmin();
      }
    }

    // ---------- گروه ----------
    match /groups/{groupId} {
      allow read: if isMember(resource.data);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins
        && request.resource.data.ownerId == request.auth.uid;
      // ادمین: هر تغییری مجاز (اعضا/ادمین‌ها/اسم/عکس). عضو عادی: فقط فیلدهای مربوط به ارسال پیام یا خروجِ خودش از گروه.
      allow update: if isMember(resource.data) && (
        isGroupAdmin(resource.data)
        || onlyChanged(["lastMessage", "lastMessageAt", "lastSenderId", "unreadCounts"])
        || (
          onlyChanged(["members", "admins"])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && request.resource.data.admins == resource.data.admins.removeAll([request.auth.uid])
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data)
          && onlyChanged(["reactions"]);
        allow delete: if isAdmin();
      }
    }

    // ---------- کانال ----------
    match /channels/{channelId} {
      allow read: if resource.data.isPublic == true || (signedIn() && request.auth.uid in resource.data.subscribers);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.subscribers
        && request.auth.uid in request.resource.data.admins
        && request.resource.data.ownerId == request.auth.uid;
      // ادمین: هر تغییری (پست، افزودن ادمین، تغییر اسم). عضو عادی: فقط عضویت/لغو عضویتِ خودش.
      allow update: if signedIn() && (
        isGroupAdmin(resource.data)
        || (
          onlyChanged(["subscribers", "admins"])
          && request.resource.data.subscribers == resource.data.subscribers.removeAll([request.auth.uid])
          && request.resource.data.admins == resource.data.admins.removeAll([request.auth.uid])
        )
        || (
          onlyChanged(["subscribers"])
          && request.resource.data.subscribers == resource.data.subscribers.union([request.auth.uid])
        )
      );
      allow delete: if false;

      match /posts/{postId} {
        allow read: if get(/databases/$(database)/documents/channels/$(channelId)).data.isPublic == true
          || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.subscribers);
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.admins
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isMember(get(/databases/$(database)/documents/channels/$(channelId)).data)
          && onlyChanged(["reactions"]);
        allow delete: if isAdmin();
      }
    }

    // ---------- گزارش پیام (برای آینده — هر کاربر می‌تونه بسازه، فقط ادمین می‌بینه) ----------
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
