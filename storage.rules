rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == "YTxAE8HNmPYfVfNBJCUPlG9ai3Y2"; }
    function underSizeLimit() { return request.resource.size < 25 * 1024 * 1024; } // ۲۵ مگابایت سقف هر فایل
    function isAllowedType() {
      return request.resource.contentType.matches("image/.*")
        || request.resource.contentType.matches("video/.*")
        || request.resource.contentType.matches("audio/.*")
        || request.resource.contentType.matches("application/pdf");
    }
    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members;
    }
    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.members;
    }
    function isChannelAdmin(channelId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/channels/$(channelId)).data.admins;
    }
    function isChannelSubscriber(channelId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/channels/$(channelId)).data.subscribers;
    }

    match /chat_media/{chatId}/{fileName} {
      allow read: if isChatMember(chatId);
      allow write: if isChatMember(chatId) && underSizeLimit() && isAllowedType();
      allow delete: if isAdmin();
    }

    match /group_media/{groupId}/{fileName} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupMember(groupId) && underSizeLimit() && isAllowedType();
      allow delete: if isAdmin();
    }

    match /channel_media/{channelId}/{fileName} {
      allow read: if isChannelSubscriber(channelId);
      allow write: if isChannelAdmin(channelId) && underSizeLimit() && isAllowedType();
      allow delete: if isAdmin();
    }

    // هر مسیر دیگری که تعریف نشده، به‌طور پیش‌فرض کاملاً بسته است
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
